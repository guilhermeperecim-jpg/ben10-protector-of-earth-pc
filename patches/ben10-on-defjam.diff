+    {
+        std::fwrite(vuCode, 1, codeSize, f);
+        std::fclose(f);
+    }
+    if (FILE *f = std::fopen((base + "_data.bin").c_str(), "wb"))
+    {
+        std::fwrite(vuData, 1, dataSize, f);
+        std::fclose(f);
+    }
+    if (FILE *f = std::fopen((base + "_regs.txt").c_str(), "w"))
+    {
+        std::fprintf(f, "pc %x program %x top %x itop %x q %.9g p %.9g i %.9g r %x clip %x mac %x status %x%c", pc,
+                     g_vu1LastStartPc, top, itop, state.q, state.p, state.i, state.r, state.clip, state.mac, state.status, 10);
+        std::fprintf(f, "acc %.9g %.9g %.9g %.9g%c", state.acc[0], state.acc[1], state.acc[2], state.acc[3], 10);
+        for (int r = 0; r < 32; ++r)
+            std::fprintf(f, "vf%d %.9g %.9g %.9g %.9g%c", r, state.vf[r][0], state.vf[r][1], state.vf[r][2], state.vf[r][3], 10);
+        for (int r = 0; r < 16; ++r)
+            std::fprintf(f, "vi%d %d%c", r, state.vi[r], 10);
+        std::fclose(f);
+    }
+}
