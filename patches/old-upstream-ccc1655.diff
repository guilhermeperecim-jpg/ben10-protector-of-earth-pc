+    // Looks a path up in the ISO9660 directory of the configured disc image (PS2X_CD_IMAGE): the file's real first
+    // sector and size, the same sectors the IOP's cdvdman reads from that image.
+    bool findCdImageFile(const std::string &ps2Path, uint32_t &lbnOut, uint32_t &sizeOut)
+    {
+        const std::filesystem::path image = getCdImagePath();
+        if (image.empty())
+        {
+            return false;
+        }
+        std::array<uint8_t, kCdSectorSize> pvd{};
+        if (!readHostRange(image, 16ull * kCdSectorSize, pvd.data(), pvd.size()) || std::memcmp(pvd.data() + 1, "CD001", 5) != 0)
+        {
+            return false;
+        }
+        uint32_t dirLbn = 0u, dirSize = 0u;
+        std::memcpy(&dirLbn, pvd.data() + 156 + 2, 4);
+        std::memcpy(&dirSize, pvd.data() + 156 + 10, 4);
+
+        std::string path = normalizeCdPathNoPrefix(ps2Path);
+        std::vector<std::string> parts;
+        for (size_t start = 0u; start <= path.size();)
+        {
+            const size_t end = std::min(path.find_first_of("/\\", start), path.size());
+            std::string part = toLowerAscii(path.substr(start, end - start));
+            part = part.substr(0, part.find(';'));
+            if (!part.empty())
+                parts.push_back(part);
+            start = end + 1u;
+        }
+        if (parts.empty() || dirSize > (1u << 20))
+        {
+            return false;
+        }
+        for (size_t i = 0u; i < parts.size(); ++i)
+        {
+            std::vector<uint8_t> dir(dirSize);
+            if (!readHostRange(image, static_cast<uint64_t>(dirLbn) * kCdSectorSize, dir.data(), dir.size()))
+            {
+                return false;
+            }
+            bool found = false;
+            for (size_t pos = 0u; pos < dir.size();)
+            {
+                const uint8_t length = dir[pos];
+                if (length == 0u) // records never cross a sector: skip to the next one
+                {
+                    pos = (pos / kCdSectorSize + 1u) * kCdSectorSize;
+                    continue;
+                }
+                if (pos + length > dir.size() || length < 34u)
+                {
+                    break;
+                }
+                const uint8_t nameLength = dir[pos + 32];
+                std::string name = toLowerAscii(std::string(reinterpret_cast<const char *>(&dir[pos + 33]), nameLength));
+                name = name.substr(0, name.find(';'));
+                if (name == parts[i] && ((dir[pos + 25] & 2u) != 0u) == (i + 1u < parts.size()))
+                {
+                    std::memcpy(&dirLbn, &dir[pos + 2], 4);
+                    std::memcpy(&dirSize, &dir[pos + 10], 4);
+                    found = true;
+                    break;
+                }
+                pos += length;
+            }
+            if (!found)
+            {
+                return false;
+            }
+        }
+        lbnOut = dirLbn;
+        sizeOut = dirSize;
+        return true;
+    }
